# Copy to .env (git-ignored). Only for local test builds; production builds should leave these empty
# so the app asks for the server through the QR/manual setup and never carries a key in the package.

# Bake a server and API key into the build (skips setup on the TV). Test builds only.
VITE_IMMICH_URL=
VITE_IMMICH_KEY=

# Enable QR pairing: URL of the pairing service (relay) and of the phone page it serves.
VITE_RELAY_URL=
VITE_PAIR_PAGE_URL=
